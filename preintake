<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>THE HUMAN LAB — Structural Diagnostic Intake</title>
<style>
:root {
  --bg: #1D1C17;
  --surface: #403D3D;
  --accent: #CCB98D;
  --text: #E8E6E1;
  --text-muted: #9C9A94;
  --error: #B85450;
  --border: #2A2924;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Helvetica Neue', Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

body {
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.container {
  width: 100%;
  max-width: 640px;
  background: var(--bg);
  border: 1px solid var(--border);
  position: relative;
}

.progress {
  height: 2px;
  background: var(--surface);
  position: relative;
}

.progress-bar {
  height: 100%;
  background: var(--accent);
  width: 0%;
  transition: width 0.3s ease;
}

.timer {
  position: absolute;
  top: 12px;
  right: 16px;
  font-size: 11px;
  color: var(--text-muted);
  letter-spacing: 1px;
  font-variant-numeric: tabular-nums;
}

.screen {
  display: none;
  padding: 60px 40px 40px;
  min-height: 500px;
  flex-direction: column;
}

.screen.active {
  display: flex;
}

.title {
  font-size: 24px;
  font-weight: 600;
  letter-spacing: 0.5px;
  margin-bottom: 8px;
  text-transform: uppercase;
}

.subheading {
  font-size: 14px;
  color: var(--accent);
  letter-spacing: 1px;
  margin-bottom: 40px;
  text-transform: uppercase;
}

.body {
  font-size: 16px;
  line-height: 1.6;
  color: var(--text);
  margin-bottom: 32px;
}

.prompt {
  font-size: 18px;
  line-height: 1.5;
  margin-bottom: 24px;
  font-weight: 500;
}

.label {
  font-size: 14px;
  color: var(--text-muted);
  margin-bottom: 8px;
  display: block;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

input[type="text"], input[type="email"], textarea, select {
  width: 100%;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 14px 16px;
  font-size: 16px;
  margin-bottom: 8px;
  outline: none;
  transition: border 0.2s ease;
}

input[type="text"]:focus, input[type="email"]:focus, textarea:focus, select:focus {
  border-color: var(--accent);
}

textarea {
  resize: vertical;
  min-height: 80px;
  line-height: 1.5;
}

.microcopy {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 32px;
  line-height: 1.5;
}

.rules {
  font-size: 12px;
  color: var(--text-muted);
  margin: 32px 0 16px;
  line-height: 1.6;
}

.footer-note {
  font-size: 10px;
  color: var(--text-muted);
  margin-top: auto;
  padding-top: 32px;
  line-height: 1.5;
  opacity: 0.7;
}

.char-count {
  font-size: 11px;
  color: var(--text-muted);
  text-align: right;
  margin-top: -4px;
  margin-bottom: 16px;
}

.char-count.error {
  color: var(--error);
}

.btn {
  background: var(--accent);
  color: var(--bg);
  border: none;
  padding: 16px 32px;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  cursor: pointer;
  margin-top: auto;
  transition: opacity 0.2s ease;
}

.btn:hover {
  opacity: 0.9;
}

.btn:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.btn-group {
  display: flex;
  gap: 12px;
  margin-top: auto;
}

.btn-secondary {
  background: transparent;
  color: var(--text-muted);
  border: 1px solid var(--surface);
}

.checkbox-group,.radio-group {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 24px;
}

.checkbox-item,.radio-item {
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 14px 16px;
  cursor: pointer;
  transition: border 0.2s ease;
}

.checkbox-item:hover,.radio-item:hover {
  border-color: var(--accent);
}

.checkbox-item input,.radio-item input {
  margin-right: 12px;
  width: 16px;
  height: 16px;
  accent-color: var(--accent);
}

.question-block {
  margin-bottom: 32px;
}

.step-counter {
  font-size: 11px;
  color: var(--text-muted);
  letter-spacing: 1px;
  margin-bottom: 24px;
  text-transform: uppercase;
}

.power-move {
  background: var(--surface);
  border-left: 2px solid var(--accent);
  padding: 24px;
  margin: 32px 0;
  font-size: 14px;
  line-height: 1.6;
}

@media (max-width: 640px) {
.screen { padding: 40px 24px 24px; }
.title { font-size: 20px; }
.prompt { font-size: 16px; }
}
</style>
</head>
<body>
<div class="container">
  <div class="progress">
    <div class="progress-bar" id="progressBar"></div>
  </div>
  <div class="timer" id="timer">00:00</div>

  <form id="diagnosticForm" action="https://formspree.io/f/xnjwapyp" method="POST">
    <!-- SCREEN 0 -->
    <div class="screen active" data-step="0">
      <div class="title">THE HUMAN LAB</div>
      <div class="subheading">Structural Diagnostic Intake</div>
      <div class="body">
        You are not here to explain everything.<br>
        You are here to isolate a repeatable system.<br>
        Precision is required. Completion is non-negotiable.
      </div>
      <div class="rules">
        - Precision over length<br>
        - Describe what repeats<br>
        - Avoid vague language<br>
        - Progress auto-saves on this device
      </div>
      <button type="button" class="btn" onclick="nextScreen()">Begin Diagnostic</button>
      <div class="footer-note">
        Your responses are confidential and used solely for diagnostic preparation. Data deleted post-engagement.
      </div>
    </div>

    <!-- SCREEN 0.5 - NAME + EMAIL CAPTURE -->
    <div class="screen" data-step="0.5">
      <div class="step-counter">Identity</div>
      <div class="title">Identification</div>
      <div class="question-block">
        <label class="label">Full Name</label>
        <input type="text" name="name" required>
      </div>
      <div class="question-block">
        <label class="label">Email Address</label>
        <input type="email" name="email" required>
        <div class="microcopy">Used to send your diagnostic copy and session link. Progress saves automatically.</div>
      </div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 1 -->
    <div class="screen" data-step="1">
      <div class="step-counter">1 / 15</div>
      <div class="title">Define the Problem</div>
      <div class="prompt">Describe the problem in one sentence.</div>
      <input type="text" name="problem_definition" maxlength="140" required>
      <div class="char-count"><span id="count1">0</span> / 140</div>
      <div class="microcopy">If it takes longer, it is not yet clear.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 2 -->
    <div class="screen" data-step="2">
      <div class="step-counter">2 / 15</div>
      <div class="title">Where It Shows Up</div>
      <div class="prompt">Where does this problem occur most consistently?</div>
      <div class="checkbox-group">
        <label class="checkbox-item"><input type="checkbox" name="location" value="Work"> Work</label>
        <label class="checkbox-item"><input type="checkbox" name="location" value="Relationships"> Relationships</label>
        <label class="checkbox-item"><input type="checkbox" name="location" value="Self"> Self</label>
        <label class="checkbox-item"><input type="checkbox" name="location" value="Money"> Money</label>
        <label class="checkbox-item">
          <input type="checkbox" name="location" value="Other" id="otherCheck"> Other
        </label>
      </div>
      <input type="text" name="location_other" id="otherField" placeholder="Specify" maxlength="50" style="display:none;">
      <div class="microcopy">Select where the pattern repeats, not where it occasionally appears.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 3 -->
    <div class="screen" data-step="3">
      <div class="step-counter">3 / 15</div>
      <div class="title">Pattern Timing</div>
      <div class="question-block">
        <label class="label">When did this last occur?</label>
        <input type="text" name="last_occurrence" placeholder="Yesterday, 3pm, after meeting" required>
      </div>
      <div class="question-block">
        <label class="label">How often does this happen?</label>
        <select name="frequency" required>
          <option value="">Select</option>
          <option>Daily</option>
          <option>Weekly</option>
          <option>Monthly</option>
          <option>Situational</option>
        </select>
      </div>
      <div class="microcopy">We are identifying recurrence, not memory.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 4 -->
    <div class="screen" data-step="4">
      <div class="step-counter">4 / 15</div>
      <div class="title">What Starts It</div>
      <div class="prompt">What happens right before the problem begins?</div>
      <textarea name="trigger" maxlength="200" required></textarea>
      <div class="char-count"><span id="count4">0</span> / 200</div>
      <div class="microcopy">Identify the trigger or condition. Not the story.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 5 -->
    <div class="screen" data-step="5">
      <div class="step-counter">5 / 15</div>
      <div class="title">What You Do</div>
      <div class="prompt">What do you do next—every time?</div>
      <textarea name="behavior" maxlength="200" required></textarea>
      <div class="char-count"><span id="count5">0</span> / 200</div>
      <div class="microcopy">Describe behaviour. Not thoughts. Not feelings.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 6 -->
    <div class="screen" data-step="6">
      <div class="step-counter">6 / 15</div>
      <div class="title">Immediate Result</div>
      <div class="prompt">What happens immediately after?</div>
      <textarea name="consequence" maxlength="200" required></textarea>
      <div class="char-count"><span id="count6">0</span> / 200</div>
      <div class="microcopy">What does this produce?</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 7 -->
    <div class="screen" data-step="7">
      <div class="step-counter">7 / 15</div>
      <div class="title">What Repeats</div>
      <div class="prompt">What part of this cycle is the most consistent?</div>
      <textarea name="pattern_signal" maxlength="160" required></textarea>
      <div class="char-count"><span id="count7">0</span> / 160</div>
      <div class="microcopy">This is the signal. Name it directly.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 8 -->
    <div class="screen" data-step="8">
      <div class="step-counter">8 / 15</div>
      <div class="title">Where This System Lives</div>
      <div class="question-block">
        <label class="label">What environments does this pattern exist in?</label>
        <input type="text" name="environments" required>
      </div>
      <div class="question-block">
        <label class="label">Who are you typically around when this occurs?</label>
        <input type="text" name="people" required>
      </div>
      <div class="question-block">
        <label class="label">What are you repeatedly exposed to that may reinforce this?</label>
        <textarea name="reinforcers" required></textarea>
      </div>
      <div class="microcopy">Systems are sustained by inputs.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 9 -->
    <div class="screen" data-step="9">
      <div class="step-counter">9 / 15</div>
      <div class="title">How You Run It</div>
      <div class="question-block">
        <label class="label">What do you tell yourself in that moment?</label>
        <input type="text" name="self_talk" required>
      </div>
      <div class="question-block">
        <label class="label">What are you assuming is true?</label>
        <input type="text" name="assumptions" required>
      </div>
      <div class="question-block">
        <label class="label">What are you trying to avoid or secure?</label>
        <input type="text" name="avoid_secure" required>
      </div>
      <div class="microcopy">This is where distortion usually sits.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 10 -->
    <div class="screen" data-step="10">
      <div class="step-counter">10 / 15</div>
      <div class="title">What It Produces</div>
      <div class="question-block">
        <label class="label">What behaviour does this pattern create?</label>
        <input type="text" name="output_behavior" required>
      </div>
      <div class="question-block">
        <label class="label">What does it cause you to delay or avoid?</label>
        <input type="text" name="delay_avoid" required>
      </div>
      <div class="question-block">
        <label class="label">What is the immediate cost?</label>
        <input type="text" name="immediate_cost" required>
      </div>
      <div class="question-block">
        <label class="label">What is the long-term cost if unchanged?</label>
        <input type="text" name="longterm_cost" required>
      </div>
      <div class="microcopy">Cost reveals significance.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 11 - UPDATED: 3 max constraints -->
    <div class="screen" data-step="11">
      <div class="step-counter">11 / 15</div>
      <div class="title">What Hasn’t Worked</div>
      <div class="question-block">
        <label class="label">What have you already tried? Name 3 max. Short phrases.</label>
        <input type="text" name="failed_solution_1" placeholder="Attempt 1" maxlength="60" required>
        <input type="text" name="failed_solution_2" placeholder="Attempt 2" maxlength="60">
        <input type="text" name="failed_solution_3" placeholder="Attempt 3" maxlength="60">
      </div>
      <div class="question-block">
        <label class="label">Why did those attempts fail?</label>
        <textarea name="why_failed" maxlength="200" required></textarea>
        <div class="char-count"><span id="count11">0</span> / 200</div>
      </div>
      <div class="microcopy">We are identifying ineffective patterns.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 12 -->
    <div class="screen" data-step="12">
      <div class="step-counter">12 / 15</div>
      <div class="title">Your Current Model</div>
      <div class="question-block">
        <label class="label">What do you believe the problem is?</label>
        <input type="text" name="self_diagnosis_problem" required>
      </div>
      <div class="question-block">
        <label class="label">What do you believe is causing it?</label>
        <input type="text" name="self_diagnosis_cause" required>
      </div>
      <div class="microcopy">This will be tested, not accepted.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 13 - UPDATED: Structural version -->
    <div class="screen" data-step="13">
      <div class="step-counter">13 / 15</div>
      <div class="title">Constraint Reveal</div>
      <div class="prompt">What system would break if this pattern stopped?</div>
      <div class="question-block">
        <label class="label">What would you start doing immediately?</label>
        <input type="text" name="start_doing" required>
      </div>
      <div class="question-block">
        <label class="label">What would you stop doing?</label>
        <input type="text" name="stop_doing" required>
      </div>
      <div class="microcopy">This reveals hidden constraints and payoffs.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 14 -->
    <div class="screen" data-step="14">
      <div class="step-counter">14 / 15</div>
      <div class="title">Final Check</div>
      <div class="prompt">Did you answer based on what is true, or what sounds reasonable?</div>
      <div class="radio-group">
        <label class="radio-item">
          <input type="radio" name="integrity_check" value="What is true" required> What is true
        </label>
        <label class="radio-item">
          <input type="radio" name="integrity_check" value="What sounds reasonable"> What sounds reasonable
        </label>
      </div>
      <div class="microcopy">Accuracy determines precision.</div>
      <div class="btn-group">
        <button type="button" class="btn btn-secondary" onclick="prevScreen()">Back</button>
        <button type="button" class="btn" onclick="validateAndNext()">Next</button>
      </div>
    </div>

    <!-- SCREEN 15 -->
    <div class="screen" data-step="15">
      <div class="step-counter">15 / 15</div>
      <div class="title">Submit Diagnostic</div>
      <div class="body">
        Your responses will be analysed before your session.<br>
        Clarity here directly impacts the precision of your diagnosis.
      </div>
      <button type="submit" class="btn">Submit</button>
    </div>

    <!-- SUCCESS SCREEN -->
    <div class="screen" data-step="16">
      <div class="title">DIAGNOSTIC RECEIVED</div>
      <div class="power-move">
        Preliminary pattern detected.<br>
        Final structure will be mapped in session.
      </div>
      <div class="body">Check your email for session confirmation.</div>
    </div>
  </form>
</div>

<script>
let currentScreen = 0;
const totalScreens = 15;
const form = document.getElementById('diagnosticForm');
const screens = document.querySelectorAll('.screen');
const progressBar = document.getElementById('progressBar');
const timerEl = document.getElementById('timer');
let startTime = Date.now();
let timerInterval;

// Live timer
function updateTimer() {
  const elapsed = Math.floor((Date.now() - startTime) / 1000);
  const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
  const secs = String(elapsed % 60).padStart(2, '0');
  timerEl.textContent = `${mins}:${secs}`;
}
timerInterval = setInterval(updateTimer, 1000);

// Character counters
document.querySelectorAll('input[maxlength], textarea[maxlength]').forEach(el => {
  const step = el.closest('.screen').dataset.step;
  const countEl = document.getElementById('count' + step);
  if(countEl) {
    el.addEventListener('input', () => {
      countEl.textContent = el.value.length;
      countEl.parentElement.classList.toggle('error', el.value.length >= el.maxLength);
    });
  }
});

// Other checkbox toggle
document.getElementById('otherCheck')?.addEventListener('change', (e) => {
  const otherField = document.getElementById('otherField');
  otherField.style.display = e.target.checked? 'block' : 'none';
  otherField.required = e.target.checked;
});

// Navigation
function updateProgress() {
  const percent = (currentScreen / totalScreens) * 100;
  progressBar.style.width = percent + '%';
}

function showScreen(n) {
  screens.forEach(s => s.classList.remove('active'));
  screens[n].classList.add('active');
  currentScreen = n;
  updateProgress();
  window.scrollTo(0,0);
  saveFormData();
}

function nextScreen() {
  if(currentScreen < totalScreens + 1) showScreen(currentScreen + 1);
}

function prevScreen() {
  if(currentScreen > 0) showScreen(currentScreen - 1);
}

function validateAndNext() {
  const current = screens[currentScreen];
  const inputs = current.querySelectorAll('input[required], textarea[required], select[required]');
  let valid = true;

  inputs.forEach(input => {
    if(input.type === 'checkbox' || input.type === 'radio') {
      const group = current.querySelectorAll(`input[name="${input.name}"]`);
      if(![...group].some(i => i.checked)) valid = false;
    } else if(!input.value.trim()) {
      valid = false;
    }
    if(input.type === 'email' && input.value &&!input.validity.valid) valid = false;
  });

  // Screen 2 needs at least one checkbox
  if(current.dataset.step === "2") {
    const checked = current.querySelectorAll('input[name="location"]:checked');
    if(checked.length === 0) valid = false;
  }

  if(valid) nextScreen();
  else alert('Complete all required fields. Precision over length.');
}

// Save/load to localStorage
function saveFormData() {
  const data = new FormData(form);
  const obj = {};
  for(let [key, val] of data.entries()) {
    if(obj[key]) {
      if(!Array.isArray(obj[key])) obj[key] = [obj[key]];
      obj[key].push(val);
    } else obj[key] = val;
  }
  obj._startTime = startTime;
  localStorage.setItem('thl_intake', JSON.stringify(obj));
}

function loadFormData() {
  const saved = localStorage.getItem('thl_intake');
  if(!saved) return;
  const data = JSON.parse(saved);
  if(data._startTime) startTime = data._startTime;

  Object.keys(data).forEach(key => {
    if(key === '_startTime') return;
    const els = form.querySelectorAll(`[name="${key}"]`);
    els.forEach(el => {
      if(el.type === 'checkbox' || el.type === 'radio') {
        el.checked = Array.isArray(data[key])? data[key].includes(el.value) : data[key] === el.value;
      } else {
        el.value = data[key];
      }
    });
  });
  if(document.getElementById('otherCheck')?.checked) {
    document.getElementById('otherField').style.display = 'block';
  }
}

// Form submit to Formspree
form.addEventListener('submit', async (e) => {
  e.preventDefault();
  saveFormData();

  const formData = new FormData(form);
  formData.append('_elapsed_time', timerEl.textContent);

  try {
    const response = await fetch(form.action, {
      method: 'POST',
      body: formData,
      headers: { 'Accept': 'application/json' }
    });

    if(response.ok) {
      localStorage.removeItem('thl_intake');
      clearInterval(timerInterval);
      showScreen(16);
    } else {
      alert('Submission failed. Please try again or email hello@humanlabofficial.com');
    }
  } catch(err) {
    alert('Network error. Please check connection and try again.');
  }
});

// Init
loadFormData();
updateProgress();
</script>
